{
  "name": "testify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:engine && tsc -b && vite build",
    "build:engine": "esbuild src/engine.ts src/programmable-engine.ts src/script-runtime.ts src/strategy-examples.ts src/types.ts src/portfolio.ts src/research.ts src/data-validation.ts src/storage.ts src/marketData.ts src/results.ts src/manual-engine.ts src/execution-costs.ts src/batch-plan.ts --outdir=lib/shared --format=esm --platform=node",
    "pretest": "npm run build:engine",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "predev": "npm run build:engine",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run build && npm test && npm run test:e2e",
    "db:init": "node --env-file=.env.local scripts/init-auth-db.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.95",
    "@fontsource/inter": "^5.3.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.140",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.57.0",
    "motion": "^14.0.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
